sequenceDiagram
  actor customer as Customer
  participant controller as OrdersController
  participant service as CreateOrderService
  participant products as ProductRepository
  participant orders as OrderRepository

  customer->>controller: POST /orders
  controller->>service: execute(command)
  Note over service: transaction starts
  service->>products: lockBySku(skus)
  products-->>service: products
  alt stock insufficient (RN-002)
    service-->>controller: InsufficientStock
    controller-->>customer: 409
  else stock available
    service->>products: decrease(stock)
    service->>orders: save(order)
    orders-->>service: order
    Note over service: transaction commits
    service-->>controller: order
    controller-->>customer: 201 order number
  end
