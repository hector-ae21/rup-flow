@startuml
!theme plain
hide empty members
skinparam linetype polyline
top to bottom direction

class "Warehouse" as user <<actor>>
class "shipOrderScreen" as screen <<boundary>>
class "shipOrderController" as controller <<control>>
class "Entity" as entity <<entity>>

user --> screen : 1: acts
screen --> controller : 2: requests
controller --> entity : 3: reads and updates

@enduml
