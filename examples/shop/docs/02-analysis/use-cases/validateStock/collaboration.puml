@startuml
!theme plain
hide empty members
skinparam linetype polyline
top to bottom direction

class "Customer" as user <<actor>>
class "validateStockScreen" as screen <<boundary>>
class "validateStockController" as controller <<control>>
class "Entity" as entity <<entity>>

user --> screen : 1: acts
screen --> controller : 2: requests
controller --> entity : 3: reads and updates

@enduml
