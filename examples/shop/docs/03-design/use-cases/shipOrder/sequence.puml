@startuml
!theme plain
skinparam linetype polyline
skinparam responseMessageBelowArrow true

actor "Warehouse" as actor
participant "shipOrderController" as controller
participant "shipOrderService" as service
database "Repository" as repository

actor -> controller : request
controller -> service : execute(command)
service -> repository : save(entity)
repository --> service : entity
service --> controller : result
controller --> actor : response

@enduml
